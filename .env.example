# ==============================================================================
# ComplyErg Platform — Environment Configuration Template (.env.example)
# ==============================================================================
# Staff Security Guideline:
# Copy this file to '.env' and populate with cryptographically secure values.
# NEVER commit the actual '.env' file containing real credentials to version control.
#
# Generate secure 256-bit keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="ComplyErg"

# ------------------------------------------------------------------------------
# Cryptographic Security & JWT Configuration
# ------------------------------------------------------------------------------
# Mandatory: Must be at least 32 characters long.
# Example generation: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_cryptographically_secure_random_key_min_32_chars

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# When deployed with docker-compose or production Postgres:
POSTGRES_USER=complyerg_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=complyerg_db

# Optional: Complete Database URI override.
# If left commented out, the application will construct the URI from above or fallback to SQLite.
# DATABASE_URL=postgresql://complyerg_admin:secure_password@localhost:5432/complyerg_db

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcard '*' is strictly forbidden.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# File Storage & Inspection Evidence
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
